# LoxPanel Docker-Konfiguration — nach .env kopieren (gitignored).
# Miniserver-Zugang:
LOXPANEL_MS_HOST=192.168.1.50
LOXPANEL_MS_USER=LoxoneUser
LOXPANEL_MS_PASS=dein-passwort
LOXPANEL_MS_PORT=443
# Gen2 mit selbstsigniertem Zertifikat -> false:
LOXPANEL_MS_VERIFY_TLS=false
# Zeitzone des Containers (IANA-Name). Ohne sie laeuft er in UTC, und die
# Termine am Panel stehen um den UTC-Abstand verschoben:
TZ=Europe/Vienna

{
  "_comment": "LoxPanel Plugin-Konfiguration. Kopiere diese Datei nach loxpanel.cfg und passe sie an.",

  "miniserver": {
    "_comment": "Bevorzugt aus der LoxBerry-Miniserver-Verwaltung (msno). host/user/pass als Fallback/Standalone. Gen2 = HTTPS mit selbstsigniertem Zertifikat -> verify_tls:false. response_timeout: Sekunden, die der Miniserver fuer eine Antwort bekommt (etwa auf die Anmeldung beim Pruefen eines neuen Zugangs unter Settings -> Miniserver); antwortet er nicht rechtzeitig, gilt er als nicht erreichbar. Standard 10 = so lange darf auch ein Befehl dauern.",
    "msno": 1,
    "host": "192.168.1.50",
    "user": "LoxoneUser",
    "pass": "CHANGEME",
    "port": 443,
    "verify_tls": false,
    "response_timeout": 10
  },

  "loxone": {
    "_comment": "Phase-2-Live-Anbindung: Polling-Intervall in Sekunden (bis der WebSocket-Event-Stream in Phase 2b kommt).",
    "poll_interval": 1.0
  },

  "mqtt": {
    "_comment": "Broker fuer die Panel-Seite (Daemon <-> openHASP). Oft der LoxBerry-eigene Broker.",
    "host": "127.0.0.1",
    "port": 1883,
    "user": "",
    "pass": "",
    "base_topic": "hasp"
  },

  "web": {
    "_comment": "Basis-URL, unter der LoxBerry die gerasterten Icons/Cover ausliefert.",
    "asset_base_url": "http://loxberry/plugins/loxpanel/assets"
  },

  "lms": {
    "_comment": "Standard-LMS/MS4H fuer Musik, sofern nicht pro Player-Seite ueberschrieben.",
    "host": "192.168.1.50",
    "port": 9000
  },

  "audio": {
    "_comment": "Loxone-Audioserver (echt oder MS4H) fuer Favoriten-Wiedergabe via Loxone-Music-Server-Protokoll (Port 7091). host optional: wird sonst automatisch aus den Cover-URLs erkannt. enabled:false schaltet die Direktsteuerung ab.",
    "host": "",
    "port": 7091,
    "enabled": true
  },

  "calendar": {
    "_comment": "Front (Screensaver): Termine aus iCal-Abos und Wetter (Open-Meteo). sources: bis zu 8 Abos (Familie, Muellabfuhr, Geburtstage, Ferien, ...), jeweils webcal:// oder https:// Abo-Link (Apple/iCloud, Google, ...) mit Name und Farbe; alle werden zu einer Liste zusammengefuehrt. ical_url: alte Einzel-URL, wird als erste Quelle mitgelesen. holiday_url: zweiter iCal nur fuer Feiertage (rote Tage im Monatsraster). name: Ueberschrift am Panel. colors: false zeigt die Termine schlicht ohne Kalenderfarben. sv_events: wie viele Termine auf die Uhr-Seite passen (1-10). lat/lon: Standort in Dezimalgrad fuer das Wetter (leer/null = kein Wetter, kein API-Key noetig). days: Termine der naechsten n Tage; fore_days: Wetter-Vorschautage (1-7). Pflegbar unter /config -> Settings -> Kalender & Wetter.",
    "sources": [],
    "ical_url": "",
    "holiday_url": "",
    "name": "Family",
    "colors": true,
    "sv_events": 3,
    "lat": null,
    "lon": null,
    "days": 14,
    "fore_days": 4
  }
}
